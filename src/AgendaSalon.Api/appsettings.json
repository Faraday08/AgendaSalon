{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Agenda": "Server=localhost;Database=AgendaSalon;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Agenda": {
    "IntervaloMinutos": 15,
    "AnticipacionMinimaMinutos": 60,
    "DiasMaximosAdelanto": 30,
    "ZonaHoraria": "America/Santo_Domingo"
  },
  "Jwt": {
    "Emisor": "AgendaSalon",
    "Audiencia": "AgendaSalon.Panel",
    "MinutosExpiracion": 60
  },
  "Orientador": {
    "Modelo": "claude-opus-5-5",
    "Esfuerzo": "low",
    "MaximoTokensRespuesta": 2048,
    "MaximoPasosPorTurno": 8,
    "MaximoMensajesPorConversacion": 30,
    "LongitudMaximaMensaje": 500,
    "MinutosDeInactividad": 30
  },
  "Cors": {
    "Origenes": [ "http://localhost:5173" ]
  }
}
