@api = http://localhost:5063/api

### Servicios del salón
GET {{api}}/servicios

### Estilistas que hacen el servicio 1
GET {{api}}/estilistas?servicioId=1

### Horas libres para un servicio en una fecha
GET {{api}}/disponibilidad?servicioId=1&fecha=2026-10-29

### Reservar (sin estilista: se asigna el primero libre)
POST {{api}}/citas
Content-Type: application/json

{
  "servicioId": 1,
  "estilistaId": null,
  "inicio": "2026-10-29T10:00:00",
  "clienteNombre": "María Rodríguez",
  "clienteTelefono": "809-555-1234",
  "notas": "Primera vez en el salón"
}

### Consultar una cita (reemplaza el código)
GET {{api}}/citas/ABC234

### Cancelar una cita
POST {{api}}/citas/ABC234/cancelacion
Content-Type: application/json

{
  "telefono": "809-555-1234"
}

############ Panel del salón ############
# Usa el correo y la contraseña que configuraste en user-secrets (AdminInicial). No los guardes en este archivo.
@correoAdmin = admin@tusalon.com
@contrasenaAdmin = escribe-aqui-la-contraseña

### Iniciar sesión (el token se reutiliza en las peticiones de abajo)
# @name login
POST {{api}}/auth/login
Content-Type: application/json

{
  "correo": "{{correoAdmin}}",
  "contrasena": "{{contrasenaAdmin}}"
}

### Agenda de un día
GET {{api}}/panel/citas?desde=2026-10-29&hasta=2026-10-29
Authorization: Bearer {{login.response.body.$.token}}

### Marcar una cita como completada (reemplaza el código)
POST {{api}}/panel/citas/ABC234/completada
Authorization: Bearer {{login.response.body.$.token}}

### Crear la cuenta de un estilista (solo administradores)
POST {{api}}/panel/usuarios/estilistas
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "nombre": "Luis Peña",
  "correo": "luis@tusalon.com",
  "contrasena": "Barberia2026Luis",
  "estilistaId": 2
}
